# Ignorar a pasta node_modules dentro da pasta chatbot
chatbot/node_modules/

# Outras coisas comuns para ignorar em projetos Node.js:
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diretórios temporários do sistema
.DS_Store
Thumbs.db

# Pastas de build/output (se tiver)
dist/
build/

# Configurações locais do editor (exemplo VSCode)
.vscode/
